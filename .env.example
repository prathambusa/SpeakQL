# ── LLM ────────────────────────────────────────────────────────────────────────
LLM_PROVIDER=anthropic               # "anthropic" | "openai"
ANTHROPIC_API_KEY=sk-ant-...         # your Anthropic API key
CLAUDE_MODEL=claude-sonnet-4-5       # or claude-opus-4-7, etc.

# OPENAI_API_KEY=sk-...              # required if LLM_PROVIDER=openai
# OPENAI_MODEL=gpt-4o

# ── Embedding ──────────────────────────────────────────────────────────────────
EMBEDDING_PROVIDER=local             # "local" (no key needed) | "openai"
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ── Database aliases ───────────────────────────────────────────────────────────
DB_ALIASES=default,chinook,financial,superstore

DB_DEFAULT_URL=sqlite+aiosqlite:///./speakql_dev.db
DB_CHINOOK_URL=sqlite+aiosqlite:////data/chinook.db
DB_FINANCIAL_URL=sqlite+aiosqlite:////data/financial.db
DB_SUPERSTORE_URL=sqlite+aiosqlite:////data/superstore.db

# DB_PROD_URL=postgresql+asyncpg://user:password@host:5432/dbname

# ── Chroma ─────────────────────────────────────────────────────────────────────
CHROMA_MODE=http
CHROMA_PERSIST_DIR=./chroma_data
CHROMA_HOST=chroma
CHROMA_PORT=8000

# ── Pipeline tuning ────────────────────────────────────────────────────────────
TOP_K_TABLES=5
MAX_ROWS=1000
QUERY_TIMEOUT_SECONDS=30
